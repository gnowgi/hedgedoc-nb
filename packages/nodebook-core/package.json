{
  "name": "@nodebook/core",
  "version": "0.1.0",
  "description": "nodeBook CNL parser, graph engine, inference, and schema system",
  "license": "AGPL-3.0-only",
  "author": "gnowgi and the nodeBook contributors",
  "homepage": "https://nodebook.co.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnowgi/hedgedoc-nb.git",
    "directory": "packages/nodebook-core"
  },
  "keywords": [
    "cnl",
    "controlled-natural-language",
    "knowledge-graph",
    "concept-map",
    "parser",
    "markdown",
    "nodebook"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:ci": "vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "compromise": "^14.14.3",
    "mathjs": "^13.2.2",
    "tau-prolog": "^0.3.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
