{
  "name": "@nodebook/markdown-it",
  "version": "0.1.0",
  "description": "markdown-it plugin that turns nodeBook CNL code fences into hydratable placeholders",
  "license": "AGPL-3.0-only",
  "author": "gnowgi and the nodeBook contributors",
  "homepage": "https://nodebook.co.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnowgi/hedgedoc-nb.git",
    "directory": "packages/nodebook-markdown-it"
  },
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "cnl",
    "knowledge-graph",
    "nodebook"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:ci": "vitest run",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "markdown-it": ">=12"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "14.1.1",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
